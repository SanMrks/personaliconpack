<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_weather_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Wallpaper-Adaptive Liquid Glass Background Surface -->
    <ImageView
        android:id="@+id/widget_glass_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_glass" />

    <!-- Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Top Header & Icon Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_weather_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_weather_sunny"
                android:background="@drawable/bg_liquid_glass_capsule"
                android:padding="6dp"
                android:contentDescription="Weather Icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/widget_weather_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="28°"
                    android:textColor="#FFFFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_weather_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CELSIUS"
                    android:textColor="#80FFFFFF"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />
            </LinearLayout>
        </LinearLayout>

        <!-- Condition Description -->
        <TextView
            android:id="@+id/widget_weather_condition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Partly Cloudy"
            android:textColor="#FFFF2E4D"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/widget_weather_tag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OBSIDIAN BREEZE"
            android:textColor="#B8B8B8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="1dp" />

        <!-- Bottom Details: City & Range -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/widget_weather_city"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bengaluru"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_weather_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="H: 31°  L: 21°"
                android:textColor="#CCB8B8B8"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
