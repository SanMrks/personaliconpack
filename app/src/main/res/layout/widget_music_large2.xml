<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_music2_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Single Layer Frosted Liquid Glass Surface -->
    <ImageView
        android:id="@+id/widget_glass_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_card" />

    <!-- Centered Content Grid (2 Rows) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp">

        <!-- Row 1: Rectangular Curved Album Art (Left) + Split Volume Pill (Right) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <!-- Rectangular Curved Album Art -->
            <ImageView
                android:id="@+id/widget_music2_art"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music_note"
                android:background="@drawable/bg_music_rect_art"
                android:contentDescription="Album Art" />

            <!-- Space Between -->
            <View
                android:layout_width="16dp"
                android:layout_height="1dp" />

            <!-- Split Volume Rect: Minus (Left Red) | Plus (Right Glass) -->
            <LinearLayout
                android:layout_width="120dp"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Volume Down (Left Red Rect) -->
                <ImageView
                    android:id="@+id/widget_music2_vol_down"
                    android:layout_width="60dp"
                    android:layout_height="64dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_volume_minus_28"
                    android:background="@drawable/bg_volume_rect_minus"
                    android:contentDescription="Volume Down" />

                <!-- Volume Up (Right Glass Rect) -->
                <ImageView
                    android:id="@+id/widget_music2_vol_up"
                    android:layout_width="60dp"
                    android:layout_height="64dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_volume_plus_28"
                    android:background="@drawable/bg_volume_rect_plus"
                    android:contentDescription="Volume Up" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Previous Track + Next Track + Play/Pause Button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 1. Previous Track Rect -->
            <ImageView
                android:id="@+id/widget_music2_btn_prev"
                android:layout_width="64dp"
                android:layout_height="58dp"
                android:scaleType="center"
                android:src="@drawable/ic_skip_previous_34"
                android:background="@drawable/bg_music_rect_button"
                android:contentDescription="Previous Track" />

            <!-- Space -->
            <View
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <!-- 2. Next Track Rect -->
            <ImageView
                android:id="@+id/widget_music2_btn_next"
                android:layout_width="64dp"
                android:layout_height="58dp"
                android:scaleType="center"
                android:src="@drawable/ic_skip_next_34"
                android:background="@drawable/bg_music_rect_button"
                android:contentDescription="Next Track" />

            <!-- Space -->
            <View
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <!-- 3. Play / Pause Red Rect -->
            <ImageView
                android:id="@+id/widget_music2_btn_play"
                android:layout_width="64dp"
                android:layout_height="58dp"
                android:scaleType="center"
                android:src="@drawable/ic_play_arrow_34"
                android:background="@drawable/bg_music_rect_red"
                android:contentDescription="Play or Pause" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>