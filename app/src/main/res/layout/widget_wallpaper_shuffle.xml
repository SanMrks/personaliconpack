<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_shuffle_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_glass"
    android:padding="10dp"
    android:gravity="center">

    <TextView
        android:id="@+id/widget_shuffle_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1-TAP"
        android:textColor="#FFDC143C"
        android:textSize="8sp"
        android:textStyle="bold"
        android:letterSpacing="0.14" />

    <TextView
        android:id="@+id/widget_shuffle_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SHUFFLE"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.14"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/widget_shuffle_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WALLPAPER"
        android:textColor="#B8B8B8"
        android:textSize="8sp"
        android:textStyle="bold"
        android:letterSpacing="0.10"
        android:layout_marginTop="2dp" />

</LinearLayout>
