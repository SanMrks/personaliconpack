<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_music_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Wallpaper-Adaptive Liquid Glass Background Surface -->
    <ImageView
        android:id="@+id/widget_glass_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_glass" />

    <!-- Centered Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp"
        android:gravity="center">

        <!-- Top: Centered Big Album Art (Enlarged to 66dp) -->
        <ImageView
            android:id="@+id/widget_music_art"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_note"
            android:background="@drawable/bg_liquid_glass_capsule"
            android:padding="3dp"
            android:contentDescription="Album Art" />

        <!-- Center: Track Title & Artist -->
        <TextView
            android:id="@+id/widget_music_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Raven Waves"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/widget_music_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Obsidian Session"
            android:textColor="#B8B8B8"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_marginTop="1dp" />

        <!-- Compact Waveform & Time Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/widget_music_time_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01:24"
                android:textColor="#CCFFFFFF"
                android:textSize="8sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_music_wave"
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:scaleType="fitXY"
                android:src="@drawable/ic_audio_wave"
                android:contentDescription="Audio Wave" />

            <TextView
                android:id="@+id/widget_music_time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="03:45"
                android:textColor="#80FFFFFF"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- Bottom: Centered Controls Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/widget_music_btn_prev"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_skip_previous"
                android:background="@drawable/bg_liquid_glass_capsule"
                android:padding="6dp"
                android:contentDescription="Previous" />

            <ImageView
                android:id="@+id/widget_music_btn_play"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_play_arrow"
                android:background="@drawable/bg_battery_progress"
                android:padding="7dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="Play / Pause" />

            <ImageView
                android:id="@+id/widget_music_btn_next"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_skip_next"
                android:background="@drawable/bg_liquid_glass_capsule"
                android:padding="6dp"
                android:contentDescription="Next" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
