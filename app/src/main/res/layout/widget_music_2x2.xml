<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_music_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_glass"
    android:padding="10dp"
    android:gravity="center">

    <!-- Top: Centered Album Art -->
    <ImageView
        android:id="@+id/widget_music_art"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music_note"
        android:background="@drawable/bg_liquid_glass_capsule"
        android:padding="3dp"
        android:contentDescription="Album Art" />

    <!-- Center: Track Info -->
    <TextView
        android:id="@+id/widget_music_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Raven Waves"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_marginTop="5dp" />

    <TextView
        android:id="@+id/widget_music_artist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Obsidian Session"
        android:textColor="#B8B8B8"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_marginTop="1dp" />

    <!-- Bottom: Controls Row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <ImageView
            android:id="@+id/widget_music_btn_prev"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_skip_previous"
            android:background="@drawable/bg_liquid_glass_capsule"
            android:padding="6dp"
            android:contentDescription="Previous" />

        <ImageView
            android:id="@+id/widget_music_btn_play"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_play_arrow"
            android:background="@drawable/bg_battery_progress"
            android:padding="7dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Play / Pause" />

        <ImageView
            android:id="@+id/widget_music_btn_next"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_skip_next"
            android:background="@drawable/bg_liquid_glass_capsule"
            android:padding="6dp"
            android:contentDescription="Next" />
    </LinearLayout>

</LinearLayout>
