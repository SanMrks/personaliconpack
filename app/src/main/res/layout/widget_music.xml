<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_music_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Frosted Liquid Glass Dynamic Surface -->
    <ImageView
        android:id="@+id/widget_glass_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_card" />

    <!-- Main Content: Left Big Album Art + Right Centered Info & Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Left: Big Album Art (Clean, no background box) -->
        <ImageView
            android:id="@+id/widget_music_art"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_note"
            android:contentDescription="Album Art" />

        <!-- Right: Centered Track Details, Progress & Interactive Controls -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:gravity="center">

            <!-- Top Header: Brand & Live State -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_music_brand"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RAVEN AUDIO"
                    android:textColor="#FFDC143C"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10"
                    android:gravity="center_horizontal" />

                <TextView
                    android:id="@+id/widget_music_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOW PLAYING"
                    android:textColor="#80FFFFFF"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <!-- Song Title (Centered) -->
            <TextView
                android:id="@+id/widget_music_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Raven Waves"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:layout_marginTop="2dp" />

            <!-- Artist (Centered) -->
            <TextView
                android:id="@+id/widget_music_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Obsidian Crimson Session"
                android:textColor="#B8B8B8"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:layout_marginTop="1dp" />

            <!-- Clean Time & Progress Divider (Waveform Removed) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/widget_music_time_current"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01:24"
                    android:textColor="#CCFFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1.5dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="#2EFFFFFF" />

                <TextView
                    android:id="@+id/widget_music_time_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="03:45"
                    android:textColor="#80FFFFFF"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Centered Controls Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="6dp">

                <!-- Previous Button -->
                <ImageView
                    android:id="@+id/widget_music_btn_prev"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_skip_previous"
                    android:background="@drawable/bg_control_chip"
                    android:padding="7dp"
                    android:contentDescription="Previous" />

                <!-- Play / Pause Button -->
                <ImageView
                    android:id="@+id/widget_music_btn_play"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/ic_play_arrow"
                    android:background="@drawable/bg_battery_progress"
                    android:padding="8dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="Play / Pause" />

                <!-- Next Button -->
                <ImageView
                    android:id="@+id/widget_music_btn_next"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_skip_next"
                    android:background="@drawable/bg_control_chip"
                    android:padding="7dp"
                    android:contentDescription="Next" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>