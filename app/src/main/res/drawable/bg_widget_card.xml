<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 0: Frosted Liquid Obsidian Glass Body (Translucent ~86% optical clarity) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#33FFFFFF"
                android:centerColor="#1807070C"
                android:endColor="#281A0408" />
        </shape>
    </item>

    <!-- Layer 1: Top Frosted Glaze Meniscus (Liquid Glass Curvature Reflection) -->
    <item android:bottom="64dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="28dp"
                android:topRightRadius="28dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#38FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- Layer 2: Polished Specular Glass Bevel Rim (1.4dp) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke
                android:width="1.4dp"
                android:color="#60FFFFFF" />
        </shape>
    </item>
</layer-list>
