<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base liquid surface tension rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#2AFFFFFF"
                android:centerColor="#04FFFFFF"
                android:endColor="#14FFFFFF" />
            <stroke
                android:width="1.4dp"
                android:color="#90FFFFFF" />
        </shape>
    </item>
    <!-- Top liquid gloss meniscus -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="36dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#45FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>