<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 0: Frosted Liquid Glass Capsule Body -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="34dp" />
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#35FFFFFF"
                android:centerColor="#1807070C"
                android:endColor="#281A0408" />
        </shape>
    </item>

    <!-- Layer 1: Top Glaze Horizon -->
    <item android:bottom="32dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="34dp"
                android:topRightRadius="34dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#3CFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- Layer 2: Polished Specular Rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="34dp" />
            <stroke
                android:width="1.4dp"
                android:color="#66FFFFFF" />
        </shape>
    </item>
</layer-list>
