<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Transparent Glass Dock -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="36dp" />
            <gradient
                android:angle="135"
                android:startColor="#26FFFFFF"
                android:centerColor="#10050508"
                android:endColor="#1C0A0406" />
        </shape>
    </item>

    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="34dp" />
            <gradient
                android:angle="315"
                android:startColor="#28DC143C"
                android:centerColor="#00000000"
                android:endColor="#00000000" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="36dp" />
            <stroke
                android:width="1.2dp"
                android:color="#52FFFFFF" />
        </shape>
    </item>
</layer-list>
