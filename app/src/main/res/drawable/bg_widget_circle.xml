<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 0: Circular Frosted Liquid Glass Body -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="70%p"
                android:startColor="#33FFFFFF"
                android:centerColor="#1807070C"
                android:endColor="#281A0408" />
        </shape>
    </item>

    <!-- Layer 1: Top Specular Meniscus Glaze -->
    <item android:bottom="42dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- Layer 2: Polished Specular Rim -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1.5dp"
                android:color="#70FFFFFF" />
        </shape>
    </item>
</layer-list>
